# Emits a C++ header from a pin file. Run with:
#
#   cmake -DH47VR_PINS=<in> -DH47VR_OUT=<out> -P cmake/GeneratePins.cmake
#
# The pin file format is documented in pins/build_251800.txt. Paths in the file
# must not contain whitespace. The header is written only when its content
# changes, so a no-op configure does not invalidate downstream object files.

if(NOT DEFINED H47VR_PINS OR NOT DEFINED H47VR_OUT)
  message(FATAL_ERROR "H47VR_PINS and H47VR_OUT are required")
endif()

file(STRINGS "${H47VR_PINS}" _lines)

set(_appid "")
set(_buildid "")
set(_entries "")
set(_count 0)

foreach(_line IN LISTS _lines)
  string(STRIP "${_line}" _s)
  if(_s STREQUAL "" OR _s MATCHES "^#")
    continue()
  endif()

  string(REGEX REPLACE "[ \t]+" ";" _parts "${_s}")
  list(LENGTH _parts _n)
  list(GET _parts 0 _key)

  if(_key STREQUAL "appid")
    list(GET _parts 1 _appid)
  elseif(_key STREQUAL "buildid")
    list(GET _parts 1 _buildid)
  elseif(_key STREQUAL "module")
    if(_n LESS 3)
      message(FATAL_ERROR "Malformed module pin: ${_line}")
    endif()
    list(GET _parts 1 _path)
    list(GET _parts 2 _hash)
    string(APPEND _entries "  { \"${_path}\", \"${_hash}\" },\n")
    math(EXPR _count "${_count} + 1")
  else()
    message(FATAL_ERROR "Unknown pin key '${_key}' in: ${_line}")
  endif()
endforeach()

if(_count EQUAL 0)
  message(FATAL_ERROR "No module pins found in ${H47VR_PINS}")
endif()

set(_out "// Generated by cmake/GeneratePins.cmake from ${H47VR_PINS} - do not edit.\n")
string(APPEND _out "#pragma once\n\n")
string(APPEND _out "#include <cstddef>\n\n")
string(APPEND _out "namespace h47vr::pins {\n\n")
string(APPEND _out "inline constexpr char kAppId[] = \"${_appid}\";\n")
string(APPEND _out "inline constexpr char kBuildId[] = \"${_buildid}\";\n\n")
string(APPEND _out "struct ModulePin {\n  const char* relativePath;\n  const char* sha256;\n};\n\n")
string(APPEND _out "inline constexpr ModulePin kModules[] = {\n${_entries}};\n\n")
string(APPEND _out "inline constexpr std::size_t kModuleCount = ${_count};\n\n")
string(APPEND _out "}  // namespace h47vr::pins\n")

set(_out_path "${H47VR_OUT}")
if(EXISTS "${_out_path}")
  file(READ "${_out_path}" _old)
else()
  set(_old "")
endif()

if(NOT _old STREQUAL _out)
  get_filename_component(_out_dir "${_out_path}" DIRECTORY)
  file(MAKE_DIRECTORY "${_out_dir}")
  file(WRITE "${_out_path}" "${_out}")
  message(STATUS "h47vr: regenerated ${_out_path} (${_count} modules, buildid ${_buildid})")
endif()
